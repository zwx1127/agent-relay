{
  "name": "@asuka1127/agent-relay",
  "version": "0.3.0-next.2",
  "description": "Remote-control local Codex, Claude Code and DeepSeek Harness sessions from Telegram or Lark.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zwx1127/agent-relay.git"
  },
  "bugs": {
    "url": "https://github.com/zwx1127/agent-relay/issues"
  },
  "homepage": "https://github.com/zwx1127/agent-relay#readme",
  "keywords": [
    "codex",
    "claude-code",
    "deepseek-harness",
    "telegram-bot",
    "lark",
    "feishu",
    "cli-agent",
    "remote-control",
    "automation"
  ],
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:codex-contract": "bun scripts/codex-appserver-contract.ts",
    "test:smoke": "bun test test/integration/pty-smoke.test.ts test/integration/relay-script.test.ts",
    "gateway": "bun src/gateway/manage.ts",
    "codex:gateway": "bun src/gateway/codex-launcher.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test:codex-gateway-boundary": "bun scripts/codex-gateway-boundary-contract.ts",
    "cli": "bun --no-env-file src/cli/main.ts",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.63.1",
    "ignore": "^7.0.5",
    "bun": "1.3.11"
  },
  "bin": {
    "agent-relay": "bin/agent-relay.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
