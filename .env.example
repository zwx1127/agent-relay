IM_PROVIDER=telegram
AGENT_PROVIDER=codex

TELEGRAM_BOT_TOKEN=123:abc
ALLOWED_USER_IDS=123456
WORKSPACE_ROOT=/absolute/path/to/workspaces

# For Lark, set IM_PROVIDER=lark and use a self-built app.
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=xxx
# LARK_DOMAIN=feishu

# Optional: restrict the relay to one or more conversations. Provider IDs are
# stored as strings, so Telegram chat ids and Lark chat ids use the same
# allowlist shape. Lark ALLOWED_USER_IDS should use sender open_id values.
# ALLOWED_CONVERSATION_IDS=-100123456

# Telegram polling and retry behavior.
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_RETRY_MAX_ATTEMPTS=3
TELEGRAM_RETRY_INITIAL_DELAY_MS=500
TELEGRAM_RETRY_MAX_DELAY_MS=10000
# Maximum inbound/outbound image or file attachment size.
MEDIA_MAX_BYTES=20971520

# Local persistence.
SQLITE_PATH=.data/agent-relay.sqlite

# Codex app-server settings.
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=on-request

# Optional Codex instruction injection. File contents are loaded first, then
# inline developer instructions are appended after a blank line.
# CODEX_DEVELOPER_INSTRUCTIONS_FILE=/absolute/path/to/developer-instructions.md
# CODEX_DEVELOPER_INSTRUCTIONS="Extra developer instructions"
# CODEX_MODEL_INSTRUCTIONS_FILE=/absolute/path/to/model-instructions.md

# Optional local agent-to-relay capabilities. When enabled, relay injects a
# helper and registered capability instructions into the agent. The API only
# listens on 127.0.0.1 and uses a startup-scoped bearer token.
RELAY_CONTROL_ENABLED=false
RELAY_CONTROL_PORT=0

# Experimental, opt-in only: share Codex threads between Relay, the native CLI,
# and supported Codex desktop apps. Nothing is started or reconfigured while
# this remains false. Run `scripts/gateway.* setup` once, then start and stop
# the independent Gateway manually with the same script.
# EXPERIMENTAL_RELAY_WORK_ENABLED=false
# EXPERIMENTAL_RELAY_GATEWAY_PORT=18765
# By default Gateway state and logs live under
# ~/.agent-relay/experimental-relay-work/. Override only when necessary.
# EXPERIMENTAL_RELAY_GATEWAY_STATE_PATH=/absolute/path/to/gateway-state.json

# Use debug only where raw messages, agent input, and agent output chunks are
# safe to log.
LOG_LEVEL=info
